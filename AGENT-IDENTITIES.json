{
  "_comment": "Single source of truth for who may commit what in this repo. Consumed by .github/workflows/identity-guard.yml. A commit author is only a LABEL; the enforcement is the path scope + trailer + branch prefix checked in CI.",
  "version": 1,
  "updated": "2026-11-06",
  "identities": [
    {
      "id": "kestrel",
      "display": "KESTREL (security desk)",
